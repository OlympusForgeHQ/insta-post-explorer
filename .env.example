DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Explicit read-only targets for the manual Places analysis JSON exporter.
# The exporter never falls back to DATABASE_URL and remote targets require SSL.
PLACES_DEVELOP_DATABASE_URL=""
PLACES_PRODUCTION_DATABASE_URL=""
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_PASSWORD_HASH=""
AUTH_DISABLED="false"
APP_OWNER_ID="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_LOGO_URL="/api/brand/logo"
IMPORT_MAX_BYTES="1000000"
# SHA-256 hash (64 hex chars) of the read-only external API key for /api/v1.
# Generate a key:  node -e "console.log('ipe_'+require('crypto').randomBytes(32).toString('base64url'))"
# Hash it:         node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "ipe_REPLACE_ME"
# Store only the hash here; never the raw key. Absent = /api/v1 fails closed (503).
EXTERNAL_API_KEY_SHA256=""
MEDIA_HOST_ALLOWLIST=""
MEDIA_PUBLIC_BASE_URL="https://pub-11ac111bad494fc2aa688c23c72d660a.r2.dev/"
MEDIA_PATH_PREFIX="originals"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET_NAME="insta-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Places (Phase F) activation flag. Server-only — never prefix with NEXT_PUBLIC_.
#   0 or absent : Places analysis is not enabled in this environment; the read
#                 API and the app keep working without a Geoapify key.
#   1           : Places analysis is enabled; a valid Geoapify configuration
#                 below is then required (enforced by scripts/vercel-preflight.mjs).
PLACES_ENABLED="0"

# Places (Phase F2) geographic resolver. Server-only — never prefix with
# NEXT_PUBLIC_ and never call Geoapify from the browser. Required only when the
# Places caption-resolution workflow runs; routes that do not use Places keep
# working without it. Empty = resolver construction fails closed with
# PLACES_RESOLVER_NOT_CONFIGURED.
GEOAPIFY_API_KEY=""
GEOAPIFY_API_BASE_URL="https://api.geoapify.com"
PLACES_RESOLVER_PROVIDER="geoapify"
PLACES_RESOLVER_TIMEOUT_MS="8000"
PLACES_RESOLVER_MAX_RESULTS="5"
# Resolver robustness for large batches. Transient failures (timeouts, network
# errors, HTTP 408/429/500/502/503/504) are retried with capped exponential
# backoff + jitter, honoring a Retry-After header. MAX_ATTEMPTS counts the first
# try (1 disables retries; bounded 1..6). RETRY_BASE_MS/RETRY_MAX_MS bound the
# backoff window in milliseconds.
PLACES_RESOLVER_MAX_ATTEMPTS="3"
PLACES_RESOLVER_RETRY_BASE_MS="250"
PLACES_RESOLVER_RETRY_MAX_MS="8000"

# Places (Phase G) map tiles. PUBLIC by design: this URL is fetched by the
# browser, so it must be a tile-only key — never the server-only GEOAPIFY_API_KEY
# used for geocoding. Empty = the /places page still works (list, filters,
# statistics, review) and states that the map is not configured.
#   https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=TILE_KEY
NEXT_PUBLIC_PLACES_TILE_URL=""
NEXT_PUBLIC_PLACES_TILE_ATTRIBUTION="Powered by Geoapify | © OpenStreetMap contributors"

# Optional MapLibre style document. When set it REPLACES the raster tiles above
# and the local globe texture: labels are drawn by the client, zoom is continuous
# and rotation and tilt are enabled. Also PUBLIC, so it must carry the same
# tile-only key — never GEOAPIFY_API_KEY. Leaving it empty keeps the raster path
# untouched, which is the rollback.
#   https://maps.geoapify.com/v1/styles/osm-bright/style.json?apiKey=TILE_KEY
NEXT_PUBLIC_PLACES_STYLE_URL=""

# Worker-side only (VPS / GitHub Environments) — NOT required by the Vercel web app.
# Read-only R2 credential scoped to the media prefix on the same R2_BUCKET_NAME.
# Kept separate from the web upload credential above. See docs/deployment.md.
R2_WORKER_ACCESS_KEY_ID=""
R2_WORKER_SECRET_ACCESS_KEY=""
# Login DSN for the restricted PostgreSQL worker role (see docs/deployment.md).
# The role `ipe_worker_reader` is created NOLOGIN by migration; provision a login
# role that inherits it and set its password out-of-band, then put its DSN here.
WORKER_DATABASE_URL=""
WORKER_OWNER_ID="local"
WORKER_ID="worker-vps-1"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_LEASE_DURATION_MS="90000"
WORKER_HEARTBEAT_INTERVAL_MS="30000"
WORKER_MAX_ATTEMPTS="3"
WORKER_TEMP_ROOT="/tmp/ipe-worker"
WORKER_LOG_LEVEL="info"
WORKER_HEALTH_HOST="127.0.0.1"
WORKER_HEALTH_PORT="8080"
WORKER_R2_MAX_BYTES="536870912"
WORKER_SHUTDOWN_TIMEOUT_MS="30000"
WORKER_JANITOR_MAX_AGE_MS="21600000"
# Compose maps this root deployment value to the worker-private R2 client.
R2_ACCOUNT_ID=""
